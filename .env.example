# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# Google Gemini API key for the AI assistant (backend-only; never exposed to the
# frontend). Get one at https://aistudio.google.com/apikey
# If unset, the assistant automatically uses a free grounded retrieval fallback.
GEMINI_API_KEY=

# Optional: override the Gemini model (defaults to gemini-flash-latest).
# GEMINI_MODEL=gemini-flash-latest
